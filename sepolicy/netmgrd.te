allow netmgrd sysfs:file { open read };
type vendor_netmgrd, domain;
type vendor_netmgrd_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vendor_netmgrd)

allow init netmgrd:process { getpgid setpgid };

allow netmgrd cgroup:file r_file_perms;
allow netmgrd cgroup_v2:file r_file_perms;

allow netmgrd self:netlink_route_socket create_socket_perms_no_ioctl;
allow netmgrd self:netlink_generic_socket create_socket_perms_no_ioctl;
allow netmgrd self:udp_socket create_socket_perms_no_ioctl;

allow netmgrd sysfs_net:dir search;
allow netmgrd sysfs_net:file rw_file_perms;
allow netmgrd vendor_toolbox_exec:file rx_file_perms;
